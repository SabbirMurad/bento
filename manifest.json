{
  "manifest_version": 3,
  "name": "Bento",
  "version": "1.0",
  "description": "A new tab page you arrange yourself. Move, restyle or switch off the clock, bookmarks, shortcuts, search and Google links.",
  "permissions": [
    "bookmarks",
    "storage",
    "history"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "assets/favicon/icon16.png",
    "32": "assets/favicon/icon32.png",
    "48": "assets/favicon/icon48.png",
    "128": "assets/favicon/icon128.png"
  }
}
